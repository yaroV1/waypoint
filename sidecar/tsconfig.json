{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    /* bundler resolution: the generated Codex bindings use extensionless imports */
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,

    /* Node runs the .ts sources directly (type stripping) */
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
